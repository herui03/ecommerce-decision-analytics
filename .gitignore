# ── Data: never committed. Rebuilt from source by the ingest scripts. ──
# Olist (CC BY-NC-SA 4.0) and the Criteo RCT (~14M rows) are downloaded on demand.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
*.duckdb
*.duckdb.wal

# ── dbt build artefacts (regenerated by `dbt build`) ──
dbt/target/
dbt/logs/
dbt/dbt_packages/
dbt/.user.yml

# ── Tableau ──
*.twb
*.twbx
*.hyper
# mart_customer_segments.csv (15 MB) is regenerable via python/export_tableau.py
tableau/extracts/mart_customer_segments.csv

# ── Secrets ──
.env
*.pem
kaggle.json

# ── Python ──
.venv/
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# ── macOS / editors ──
.DS_Store
.vscode/
.idea/

# ── Synthetic sample working files (regenerated by `python -m portfolio.pipeline sample`) ──
data/sample/
.pytest_cache/
node_modules/
